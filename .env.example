# NVIDIA NIM API key — create one at https://build.nvidia.com
# Copy this file to .env.local and fill in your key. Never commit .env.local.
NVIDIA_API_KEY=
# Optional overrides (defaults shown)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional: Deepgram Nova-2 Speech-to-Text (STT) — create one at https://deepgram.com
# Enables high-accuracy punctuation across all browsers including Safari & Firefox
DEEPGRAM_API_KEY=

# Optional: Cartesia Sonic Text-to-Speech (TTS) — create one at https://cartesia.ai
# Enables ultra-low latency, expressive natural voice read-aloud
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=62ae83ad-4f6a-430b-af41-a9bede9286ca # Gemma - Decisive Agent
